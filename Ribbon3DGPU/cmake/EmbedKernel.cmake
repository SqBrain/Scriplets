# Embeds the kernel source for run-time compilation (OpenCL, Metal).
# cmake -DKERNEL_DIR=<src/kernel> -DOUT=<RibbonKernelSource.h> -P EmbedKernel.cmake
# Our own #include "Ribbon..." lines are inlined; the text is split into chunks so no single
# string literal exceeds MSVC's limit (OpenCL takes the chunks as separate strings).

file(READ "${KERNEL_DIR}/RibbonShared.h" SHARED)
file(READ "${KERNEL_DIR}/RibbonKernel.h" KERNEL)
file(READ "${KERNEL_DIR}/RibbonKernel.cl" ENTRY_CL)
file(READ "${KERNEL_DIR}/RibbonKernel.metal" ENTRY_METAL)
string(REGEX REPLACE "#include \"Ribbon[A-Za-z]*\\.h\"" "" KERNEL "${KERNEL}")

set(CHUNK 8000)
function(emit_array NAME TEXT)
    string(LENGTH "${TEXT}" LEN)
    set(POS 0)
    set(COUNT 0)
    file(APPEND "${OUT}" "static const char* const ${NAME}[] = {\n")
    while(POS LESS LEN)
        string(SUBSTRING "${TEXT}" ${POS} ${CHUNK} PIECE)
        file(APPEND "${OUT}" "R\"RKSRC(${PIECE})RKSRC\",\n")
        math(EXPR POS "${POS} + ${CHUNK}")
        math(EXPR COUNT "${COUNT} + 1")
    endwhile()
    file(APPEND "${OUT}" "};\nstatic const int ${NAME}Count = ${COUNT};\n\n")
endfunction()

file(WRITE "${OUT}" "// Generated by cmake/EmbedKernel.cmake from src/kernel. Do not edit.\n#pragma once\n\n")
emit_array(kRibbonKernelCL "${SHARED}\n${KERNEL}\n${ENTRY_CL}")
emit_array(kRibbonKernelMetal "${SHARED}\n${KERNEL}\n${ENTRY_METAL}")
